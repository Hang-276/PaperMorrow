<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wiki项目列表</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>Wiki项目列表</h1>
    </header>
    <main>
      <ul class="project-list">
        <% projects.forEach(project => { %>
          <li>
            <a href="/<%= project %>"><%= project %></a>
          </li>
        <% }); %>
      </ul>
    </main>
    <footer>
      <p>&copy; 2023 Wiki Markdown Renderer</p>
    </footer>
  </div>
</body>
</html>